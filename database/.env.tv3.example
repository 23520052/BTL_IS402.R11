# Copy file này thành database/.env (file .env đã bị .gitignore). TUYỆT ĐỐI KHÔNG commit .env.
# Dùng dấu nháy đơn bao quanh cả chuỗi; mật khẩu không được chứa dấu nháy đơn (').
# Cần cài "ODBC Driver 18 for SQL Server" trên máy chạy script.

# Azure SQL chính (SQL admin, dùng cho benchmark/validate)
SQL_AZURE_CONN='Driver={ODBC Driver 18 for SQL Server};Server=tcp:<ten-server>.database.windows.net,1433;Database=salesdb;Uid=<admin>;Pwd=<mat-khau>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;'

# SQL Server local (so sánh local vs cloud). Docker/Express đều được.
SQL_LOCAL_CONN='Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=salesbench;Uid=sa;Pwd=<mat-khau>;Encrypt=yes;TrustServerCertificate=yes;'

# Azure SQL thứ 2 ở region xa (chỉ để đo region latency, xóa sau khi đo)
SQL_FAR_CONN='Driver={ODBC Driver 18 for SQL Server};Server=tcp:<ten-server-far>.database.windows.net,1433;Database=salesdb;Uid=<admin>;Pwd=<mat-khau>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;'
